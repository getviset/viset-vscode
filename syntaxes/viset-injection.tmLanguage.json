{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Viset Lua injections",
  "scopeName": "viset.injection.lua",
  "injectionSelector": "L:source.lua -comment -string",
  "patterns": [
    {
      "name": "meta.viset.comment.line.lua",
      "begin": "--(?!\\[=*\\[)(?=[^\\r\\n]*#\\s*viset(?:\\b|$))",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.lua"
        }
      },
      "end": "(?=\\r?$)",
      "contentName": "meta.embedded.line.toml.viset",
      "patterns": [
        {
          "include": "source.toml.viset"
        }
      ]
    },
    {
      "name": "meta.viset.comment.block.lua",
      "begin": "--\\[(=*)\\[(?=[^\\r\\n]*#\\s*viset(?:\\b|$))",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.lua"
        }
      },
      "end": "\\]\\1\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.lua"
        }
      },
      "contentName": "meta.embedded.block.toml.viset",
      "patterns": [
        {
          "include": "source.toml.viset"
        }
      ]
    },
    {
      "name": "meta.viset.javascript.long-string.lua",
      "begin": "(?<![A-Za-z0-9_.:])viset\\s*\\.\\s*javascript\\s*(?:\\(\\s*)?\\[(=*)\\[",
      "beginCaptures": {
        "0": {
          "name": "meta.function-call.viset.lua"
        }
      },
      "end": "\\]\\1\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.lua"
        }
      },
      "contentName": "meta.embedded.inline.javascript.viset",
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    {
      "name": "meta.viset.javascript.double-quoted.lua",
      "begin": "(?<![A-Za-z0-9_.:])viset\\s*\\.\\s*javascript\\s*(?:\\(\\s*)?\"",
      "beginCaptures": {
        "0": {
          "name": "meta.function-call.viset.lua"
        }
      },
      "end": "(?<!\\\\)\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.lua"
        }
      },
      "contentName": "meta.embedded.inline.javascript.viset",
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    {
      "name": "meta.viset.javascript.single-quoted.lua",
      "begin": "(?<![A-Za-z0-9_.:])viset\\s*\\.\\s*javascript\\s*(?:\\(\\s*)?'",
      "beginCaptures": {
        "0": {
          "name": "meta.function-call.viset.lua"
        }
      },
      "end": "(?<!\\\\)'",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.lua"
        }
      },
      "contentName": "meta.embedded.inline.javascript.viset",
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    }
  ]
}
